{
  "name": "leitstand",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkjive/Leitstand.git"
  },
  "description": "Developer dashboard: live system metrics, Git repos, Docker and service status",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "desktop": "electron .",
    "desktop:prod": "vite build && NODE_ENV=production electron .",
    "build": "tsc -b && pnpm typecheck:server && vite build",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "start": "pnpm dev:all"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.560.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-resizable": "^3.2.0",
    "recharts": "^3.10.1",
    "systeminformation": "^5.33.16",
    "turndown": "^7.2.4",
    "validator": "^13.15.35",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-resizable": "^3.0.8",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "electron": "^43.8.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7"
  }
}
