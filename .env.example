# Copy to .env and adjust if needed.

# Network interface the backend binds to. Default 127.0.0.1 (loopback only —
# no auth on any endpoint). Set to 0.0.0.0 only if you understand the risk.
# BIND_HOST=127.0.0.1

# Shared token for the whole API (reads included) and the metrics WebSocket.
# Leave empty for loopback-only use. REQUIRED if you set BIND_HOST=0.0.0.0.
# Generate one with: openssl rand -hex 16
# DASHBOARD_TOKEN=

# Backend port (also used by the Vite dev proxy and Electron). Default 3010.
# PORT=3010
